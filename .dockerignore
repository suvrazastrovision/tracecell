# Allow only source and reference files required by the build targets.
*
!Dockerfile
!.dockerignore
!pyproject.toml
!src/
!src/**
!schemas/
!schemas/**
!configs/
!configs/**
!warehouse/
!warehouse/dbt/
!warehouse/dbt/**
!examples/
!examples/app-datasets.json
!examples/verified-pbmc/
!examples/verified-pbmc/**
!ops/
!ops/drill_worker.py
!ops/knowledge_drill_worker.py

# Exclude generated files and credentials, including within allowed directories.
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
warehouse/dbt/target*
warehouse/dbt/logs
warehouse/dbt/dbt_packages
warehouse/dbt/.user.yml
