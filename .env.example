# TraceCell local answering-model configuration.
# Copy to .env in the repository root, then edit your private copy.
# Never add a real API key to this example or commit your .env file.
# The local app rereads these model settings; refresh the browser after editing.
# Terminal environment variables take precedence over .env values.
# Cloud mode does not load .env; configure secrets server-side for deployments.

# Safe default: QC, verified evidence lookup and manual paper comparison work
# without a model. Supported providers: disabled, openai, ollama.
SCRNA_LLM_PROVIDER=disabled

# OpenAI: set the provider above to openai and enter your own API key below.
# Calls use that key owner's API account and may incur charges.
SCRNA_LLM_MODEL=gpt-5-nano
OPENAI_API_KEY=

# Ollama alternative: set the provider above to ollama, change the existing
# SCRNA_LLM_MODEL value to qwen2.5:3b, and install/run that model in Ollama.
SCRNA_OLLAMA_URL=http://127.0.0.1:11434

# Runtime settings (PYTHONPATH, SCRNA_MODE, PORT, SCRNA_ORIGIN) are set in
# your terminal as shown in README.md; the app does not load them from .env.
