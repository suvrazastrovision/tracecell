# Add the chosen block to your ignored .env. Never put a real key in this example.
# The local app rereads these settings; refresh the browser after changing them.

# Hosted small model. Calls require the sharing checkbox in the app.
SCRNA_LLM_PROVIDER=openai
SCRNA_LLM_MODEL=gpt-5-nano
OPENAI_API_KEY=replace-with-your-own-key-in-dot-env-only

# Alternative: a locally installed/running Ollama model, without hosted API calls.
# SCRNA_LLM_PROVIDER=ollama
# SCRNA_LLM_MODEL=qwen2.5:3b
# SCRNA_OLLAMA_URL=http://127.0.0.1:11434
