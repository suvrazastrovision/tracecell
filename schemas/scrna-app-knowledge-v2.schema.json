{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scrna-app-knowledge-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_name",
    "schema_version",
    "status",
    "run_id",
    "release_id",
    "input",
    "configuration",
    "metrics",
    "exclusions",
    "passing_barcodes",
    "dbt",
    "evidence",
    "limitations"
  ],
  "properties": {
    "format_name": {
      "const": "scrna-app-knowledge"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "status": {
      "const": "verified"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input": {
      "type": "object"
    },
    "configuration": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species": {
          "enum": [
            "human",
            "mouse"
          ],
          "title": "Species",
          "type": "string"
        },
        "counts": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Counts",
          "type": "string"
        },
        "gene_ids": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gene Ids",
          "type": "string"
        },
        "gene_symbols": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gene Symbols",
          "type": "string"
        },
        "mito_mode": {
          "enum": [
            "prefix",
            "column"
          ],
          "title": "Mito Mode",
          "type": "string"
        },
        "mito_value": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mito Value",
          "type": "string"
        },
        "min_genes": {
          "maximum": 40000,
          "minimum": 0,
          "title": "Min Genes",
          "type": "integer"
        },
        "max_genes": {
          "exclusiveMinimum": 0,
          "maximum": 40001,
          "title": "Max Genes",
          "type": "integer"
        },
        "max_mito_pct": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Mito Pct",
          "type": "number"
        },
        "tissue": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tissue",
          "type": "string"
        },
        "reference_genome": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reference Genome",
          "type": "string"
        },
        "attribution": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "single_sample": {
          "const": true,
          "title": "Single Sample",
          "type": "boolean"
        },
        "public_data": {
          "const": true,
          "title": "Public Data",
          "type": "boolean"
        }
      },
      "required": [
        "species",
        "counts",
        "gene_ids",
        "gene_symbols",
        "mito_mode",
        "mito_value",
        "min_genes",
        "max_genes",
        "max_mito_pct",
        "tissue",
        "reference_genome",
        "attribution",
        "source",
        "single_sample",
        "public_data"
      ],
      "title": "Configuration",
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells_total",
        "cells_pass",
        "cells_fail",
        "features_total",
        "total_counts",
        "mitochondrial_features",
        "qc_pass_fraction"
      ],
      "properties": {
        "cells_total": {
          "type": "integer",
          "minimum": 0
        },
        "cells_pass": {
          "type": "integer",
          "minimum": 0
        },
        "cells_fail": {
          "type": "integer",
          "minimum": 0
        },
        "features_total": {
          "type": "integer",
          "minimum": 0
        },
        "total_counts": {
          "type": "integer",
          "minimum": 0
        },
        "mitochondrial_features": {
          "type": "integer",
          "minimum": 0
        },
        "qc_pass_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zero_counts",
        "low_genes",
        "high_genes",
        "high_mito"
      ],
      "properties": {
        "zero_counts": {
          "type": "integer",
          "minimum": 0
        },
        "low_genes": {
          "type": "integer",
          "minimum": 0
        },
        "high_genes": {
          "type": "integer",
          "minimum": 0
        },
        "high_mito": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "passing_barcodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 20000
    },
    "dbt": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 4
    }
  }
}
